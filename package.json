{
  "name": "openai-image-cli",
  "version": "0.0.0",
  "description": "Production CLI for OpenAI image generation and editing (oaiimage)",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "oaiimage": "./dist/cli.js"
  },
  "files": [
    "dist",
    "completions",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/main.ts",
    "build": "tsup --no-dts && tsc -p tsconfig.dts.json",
    "lint": "node --require ./scripts/eslint-typescript6-hook.cjs ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "cli-progress": "3.12.0",
    "commander": "15.0.0",
    "openai": "7.34.0",
    "ora": "9.4.1",
    "picocolors": "1.1.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript/typescript6": "6.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
